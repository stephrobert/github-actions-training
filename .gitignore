# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# act : secrets et variables locaux, jamais versionnés. Les tests passent leurs
# valeurs par des fichiers temporaires hors du dépôt, pas par ceux-ci.
.secrets
.vars

# Journaux des campagnes de validation (le verdict, lui, est versionné dans
# validation-labs.json).
.validation/

# Les solutions de référence SONT versionnées : c'est ce que le validateur pose
# par-dessus chaque point de départ. L'ancienne règle `**/solution/` masquait
# ce que le dépôt publiait déjà.

# État local de dsoxlab, propre à chaque poste.
.dsoxlab.db
.dsoxlab-context.json
